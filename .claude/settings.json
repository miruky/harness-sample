{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "japanese",
  "env": {
    "UV_CACHE_DIR": ".uv-cache"
  },
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(uv run *)",
      "Bash(uv sync)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "ask": [
      "Bash(uv add *)",
      "Bash(uv remove *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./bookings.json)",
      "Read(./evals/tasks/acceptance_*)",
      "Edit(./bookings.json)",
      "Edit(./uv.lock)",
      "Bash(git push *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyWrite": [
        "./.agents/hooks",
        "./.github/workflows",
        "./.codex"
      ],
      "denyRead": [
        "./.env",
        "./.env.local",
        "./bookings.json",
        "./evals/tasks"
      ]
    },
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": [
        "pypi.org",
        "files.pythonhosted.org"
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.agents/hooks/session_context.py\"" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.agents/hooks/guard_bash.py\"" }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.agents/hooks/protect_files.py\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.agents/hooks/check_edit.py\"", "timeout": 120 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.agents/hooks/verify_before_stop.py\"", "timeout": 300 }
        ]
      }
    ]
  }
}
